class Solution(object):
    def majorityElement(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """
        c=0
        v=0
        for num in nums:
            if c==0:
                v=num
            if num == v:
                c+=1
            else:
                c-=1
        return v
nums = list(map(int, input("Enter your numbers: ").split(",")))

solution = Solution()
print(solution.majorityElement(nums))